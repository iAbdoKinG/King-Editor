{
  "name": "king-editor-desktop",
  "productName": "Qissa",
  "version": "1.0.0",
  "description": "Qissa video editor for Windows",
  "author": "Qissa",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-app": "node copy-app.cjs",
    "start": "npm run prepare-app && electron .",
    "dist:win": "npm run prepare-app && electron-builder --win nsis portable --x64 --publish never",
    "dist:linux": "npm run prepare-app && electron-builder --linux dir --publish never"
  },
  "build": {
    "appId": "app.qissa.desktop",
    "productName": "Qissa",
    "copyright": "Qissa",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Qissa",
      "artifactName": "Qissa-Setup.${ext}",
      "installerLanguages": [
        "en_US",
        "ar_SA"
      ],
      "multiLanguageInstaller": true
    },
    "portable": {
      "artifactName": "Qissa-Portable.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "qissa",
        "name": "Qissa Project",
        "description": "Qissa Project"
      },
      {
        "ext": "kingproj",
        "name": "Qissa Project (legacy)",
        "description": "Qissa Project"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  }
}
